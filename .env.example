# Copy to `.env` and fill in from the Deuce Supabase project.
#
# Everything here is PUBLIC by design — it ships inside the app bundle. Writes
# are authorised by each match's referee token, checked in the database, not
# by keeping these values secret.
#
# NEVER put the secret / service_role key or the database password in this
# file. They bypass every check, and anything prefixed EXPO_PUBLIC_ is embedded
# in the JavaScript every user downloads.
#
# Leave the Supabase values blank to run without a backend: scoring still works
# on the device, there is just no live link to share.
#
# Dashboard → Project Settings → API Keys

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Where spectator links point, e.g. https://deuce.example.com — no trailing
# slash. Required for native builds, which have no origin of their own. The
# web build falls back to wherever it is being served from.
EXPO_PUBLIC_SITE_URL=
